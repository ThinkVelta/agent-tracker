{
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Glob",
      "Grep",
      "Read",
      "WebFetch",
      "WebSearch",
      "Bash(cat *)",
      "Bash(cd *)",
      "Bash(cd *&&*)",
      "Bash(cd * &&*)",
      "Bash(cd * && *)",
      "Bash(chmod *)",
      "Bash(find *)",
      "Bash(gh *)",
      "Bash(gh api *)",
      "Bash(gh api:*)",
      "Bash(git add *)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git commit *)",
      "Bash(git diff *)",
      "Bash(git diff)",
      "Bash(git fetch *)",
      "Bash(git log *)",
      "Bash(git log)",
      "Bash(git merge *)",
      "Bash(git status)",
      "Bash(head *)",
      "Bash(ls)",
      "Bash(ls *)",
      "Bash(make *)",
      "Bash(mkdir *)",
      "Bash(pwd)",
      "Bash(swift build)",
      "Bash(swift build *)",
      "Bash(swift test)",
      "Bash(swift test *)",
      "Bash(swift run)",
      "Bash(swift run *)",
      "Bash(swift package *)",
      "Bash(swift format *)",
      "Bash(swiftlint *)",
      "Bash(tail *)",
      "Bash(tree *)",
      "Bash(uvx pre-commit *)",
      "Bash(wc *)"
    ],
    "deny": [
      "Bash(gh pr merge)",
      "Bash(gh pr merge *)",
      "Bash(gh pr merge*)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * main)",
      "Bash(git push *:main)",
      "Bash(git push *heads/main)",
      "Bash(git push * master)",
      "Bash(git push *:master)",
      "Bash(git push *heads/master)",
      "Bash(rm ~)",
      "Bash(rm ~/*)",
      "Bash(rm * ~)",
      "Bash(rm * ~/*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/redact-secrets.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
