# Package.resolved is deliberately NOT ignored: this is an app/executable, so
# it is committed to pin exact dependency versions for reproducible builds and
# CI caching.

# Environment / secrets
.env
.env.*
*.local

# Editors
# .vscode/ is deliberately NOT ignored: settings.json and extensions.json are
# shared editor config and are committed.
.idea/

# Claude Code — machine-local state only. Shared config IS committed:
# .claude/settings.json, hooks/, rules/, skills/, agents/, and README.md.
.claude/settings.local.json
.claude/worktrees/
.claude/agent-memory/
.claude/*.lock
